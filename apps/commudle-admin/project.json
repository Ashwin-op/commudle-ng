{
  "name": "commudle-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "commudle",
  "sourceRoot": "apps/commudle-admin/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-webpack:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "customWebpackConfig": {
          "path": "./custom-webpack.config.ts",
          "mergeRules": {
            "externals": "replace"
          }
        },
        "outputPath": "dist/apps/commudle-admin/browser",
        "index": "apps/commudle-admin/src/index.html",
        "main": "apps/commudle-admin/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/commudle-admin/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/commudle-admin/src/favicon.ico",
          "apps/commudle-admin/src/assets",
          "apps/commudle-admin/src/manifest.webmanifest",
          "apps/commudle-admin/src/sitemap.xml",
          "apps/commudle-admin/src/robots.txt",
          {
            "glob": "**/*",
            "input": "node_modules/tinymce",
            "output": "/tinymce/"
          }
        ],
        "styles": [
          "node_modules/@fortawesome/fontawesome-svg-core/styles.css",
          "apps/commudle-admin/src/styles.scss",
          "node_modules/grapesjs/dist/css/grapes.min.css"
        ],
        "scripts": [],
        "serviceWorker": true,
        "ngswConfigPath": "apps/commudle-admin/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "8mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "16kb",
              "maximumError": "32kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/commudle-admin/src/environments/environment.ts",
              "with": "apps/commudle-admin/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks":true,
          "aot": false
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "commudle-admin:build:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "commudle-admin:build:production"
        },
        "development": {
          "buildTarget": "commudle-admin:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "commudle-admin:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/commudle-admin/**/*.ts", "apps/commudle-admin/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/commudle-admin/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "apps/commudle-admin/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "commudle-admin:build"
      }
    },
    "compodoc": {
      "executor": "@twittwer/compodoc:compodoc",
      "options": {
        "tsConfig": "apps/commudle-admin/tsconfig.editor.json",
        "outputPath": "dist/compodoc/commudle-admin"
      },
      "configurations": {
        "json": {
          "exportFormat": "json"
        }
      }
    },
    "server": {
      "dependsOn": ["build"],
      "executor": "@nx/angular:webpack-server",
      "options": {
        "outputPath": "dist/apps/commudle-admin/server",
        "main": "apps/commudle-admin/src/server.ts",
        "tsConfig": "apps/commudle-admin/tsconfig.server.json",
        "inlineStyleLanguage": "scss"
      },
      "configurations": {
        "production": {
          "outputHashing": "media",
          "fileReplacements": [
            {
              "replace": "apps/commudle-admin/src/environments/environment.ts",
              "with": "apps/commudle-admin/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false,
          "vendorChunk": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-ssr": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:ssr-dev-server",
      "configurations": {
        "development": {
          "browserTarget": "commudle-admin:build:development",
          "serverTarget": "commudle-admin:server:development"
        },
        "production": {
          "browserTarget": "commudle-admin:build:production",
          "serverTarget": "commudle-admin:server:production"
        }
      },
      "defaultConfiguration": "development"
    },
    "prerender": {
      "executor": "@angular-devkit/build-angular:prerender",
      "options": {
        "routes": ["/"]
      },
      "configurations": {
        "development": {
          "browserTarget": "commudle-admin:build:development",
          "serverTarget": "commudle-admin:server:development"
        },
        "production": {
          "browserTarget": "commudle-admin:build:production",
          "serverTarget": "commudle-admin:server:production"
        }
      },
      "defaultConfiguration": "production"
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/builders/release.js"
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": "self"
        },
        {
          "target": "server",
          "projects": "self"
        }
      ]
    }
  }
}
